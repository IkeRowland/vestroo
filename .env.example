# Copy to .env.local (or .env) and replace every placeholder. Never commit real secrets.

# --- Supabase (Dashboard: Project Settings > API) ---
# Project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# anon public key (safe for the browser; RLS applies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# service_role key: SERVER ONLY — bypasses RLS; never use in client bundles or NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Optional: direct Postgres (Supabase CLI, migrations, npm run smoke:rls) ---
# Prefer direct session mode (port 5432) from Dashboard → Database if pooler rejects long scripts.
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# --- Google Maps ---
# Browser: Places / Autocomplete (restrict by HTTP referrer in Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-browser-key
# Enable Maps Embed API on the same browser key for public rider /track live map (15B.5).
# Server: Distance Matrix / Static Maps for account booking snapshots / web services only
# (restrict by IP or server identity; never NEXT_PUBLIC_*). Story 18.5 — Static Maps URL is server-only.
GOOGLE_MAPS_SERVER_KEY=your-google-maps-server-key

# --- Quote pricing (server, optional — premium defaults apply if unset) ---
# PRICING_BASE_PRICE_PER_KM=22
# PRICING_HOURLY_MINIMUM_HOURS=3
# PRICING_HOURLY_BASE_RATE_ZAR=520

# --- SMS (transactional; 15B.4 — `src/services/sms.ts` Twilio) ---
# Master switch: unset or 0/false = no outbound HTTP, logs `sms_skipped` with reason sms_disabled
SMS_ENABLED=0
# `twilio` (only implementation in code). SA/Clickatell etc. = TBD separate adapter; keep Twilio in dev/stage.
# SMS_PROVIDER=twilio
# Twilio Console: Account SID + Auth Token. Legacy alias: `SMS_PROVIDER_API_KEY` = auth token only
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=
# SMS_PROVIDER_API_KEY=
# E.164 or Twilio number / Messaging Service from-number
# TWILIO_FROM_NUMBER=+27xxxxxxxxx
# SMS_PROVIDER_FROM_NUMBER=
# Default region for libphonenumber-js parsing of national formats (e.g. local mobile)
# SMS_DEFAULT_COUNTRY=ZA
#
# Runbook: set SMS_ENABLED=0 to stop spend during incidents; cap/cost in provider + Finance (see 15.14 story notes)

# --- Public rider live map (Epic 15 / 15B.5 — Q22 double opt-in with customer_accounts.live_rider_tracking) ---
# Master switch: unset or 0/false = no live map or vehicle_trackings reads for /track (milestone-only).
# Truthy same as SMS_ENABLED: 1, true, yes, on (case-insensitive after trim).
# RIDER_LIVE_LOCATION_ENABLED=0

# --- Payments ---
# Epic 16 / Theme N (US-N2) — checkout provider integration removed. Settlement is recorded
# out of band via EFT (US-N3 ships `markBookingPaymentReceived`); no provider keys live here.

# --- Resend (transactional email; server-only — never NEXT_PUBLIC_*) ---
# RESEND_API_KEY — Resend dashboard API key. Test keys use prefix `re_test_` (regex: /^re_test_/ after trim).
#   When NODE_ENV is not `production` and the key matches that test pattern, `sendEmail`
#   (`src/lib/email/send.ts`) does not call Resend; it logs to/subject/from metadata and returns
#   `{ ok: true, mode: 'skipped_test_mode' }`.
# RESEND_FROM_EMAIL — sender address registered in Resend. Required in production when calling
#   `sendEmail` without an explicit `from` field; in non-production an internal placeholder default
#   may apply if unset (see send module).
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com
# SUPPORT_EMAIL — optional customer-facing support address in transactional templates (defaults in code).
# Also used as **ops/dispatcher** recipient for `comms_dispatch_rules` roles `ops` / `dispatcher` / `admin` when set (**15C.2**).
# SUPPORT_EMAIL=support@yourdomain.com

# Epic 15 / **15C.2** — `public.profiles.id` for `ops_audit_log.actor_id` on automated comms matrix skips (service-role automation).
# Required in production if you rely on `comms_no_rule_matched` / `comms_no_active_template` audit rows for service-role paths.
# OPS_AUTOMATION_AUDIT_ACTOR_ID=

# Epic 13 **13.11** + Epic 15 **15C.7** — `GET|POST /api/cron/daily-maintenance` with `Authorization: Bearer …` (single daily surface: quote expiry RPC + invoice-due reminders). Generate a long random secret; never expose to the client.
# CRON_SECRET=

# Epic 15 / **15C.7** — invoice-due reminder windows (calendar days vs run date in `INVOICE_REMINDER_TIME_ZONE`, default Africa/Johannesburg). Overdue = due_date exactly N civil days before run.
# INVOICE_REMINDER_DAYS_BEFORE=3
# INVOICE_REMINDER_DAYS_OVERDUE=1
# INVOICE_REMINDER_TIME_ZONE=Africa/Johannesburg

# Epic 15 / **15D.2** — Fulfil assign “Suggested vehicles” panel (**`15D.1`** scoring). Server-only; unset or 0/false = panel hidden (no layout shift). Truthy: 1 | true | yes | on (case-insensitive after trim).
# DISPATCH_SUGGESTIONS_ENABLED=0

# Epic 16 / Theme A — **US-A3** (`16.22`): ops sidebar “Dispatch” link to **`/ops/dispatch`** (Theme C board).
# Unset or 0/false = item hidden (no 404 nav). Truthy: 1 | true | yes | on (case-insensitive after trim).
# NEXT_PUBLIC_OPS_DISPATCH_BOARD_NAV_ENABLED=0

# Epic 17 / **FE.17.3** (Story **17.3**) — optional sidebar promo card (**`OpsSidebarPromoSlot`**).
# Product flag name: **ops_sidebar_promo_enabled** → **`NEXT_PUBLIC_OPS_SIDEBAR_PROMO_ENABLED`**.
# **Production:** leave unset or **0** / false (promo hidden). **Staging:** often **1** / true so CMS/release notes can show.
# Truthy: 1 | true | yes | on (case-insensitive after trim). Optional JSON body:
# NEXT_PUBLIC_OPS_SIDEBAR_PROMO_JSON={"title":"What’s new","body":"Short teaser","href":"/ops","imageUrl":"/images/example.png"}
# Use **`imageUrl`** paths starting with **`/`** (optimized **`next/image`**) or same-origin absolute URLs (**`<img>`** fallback). **`href`** must be a same-app path (`/ops/...`).

# Epic 15 / **15C.3** — `/ops/comms` Q23 link for template body/subject copy changes (GitHub PR template or internal runbook). Optional; when unset, the page shows env hint text instead of an external link.
# NEXT_PUBLIC_COMMS_BODY_CHANGE_PR_GUIDE_URL=https://github.com/org/repo/compare/main...main?expand=1

# --- Supabase Storage / S3-compatible API (optional; image URLs) ---
# S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-s3-access-key-id
# S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# S3_BUCKET=media
# SUPABASE_STORAGE_BUCKET=media

# --- Story 18.6 / FE.18.5 — account portal invoice PDF downloads (server-only signed URLs) ---
# Private bucket for `booking_quotes.pdf_storage_path` object keys. Default in code: `booking-quote-pdfs`.
# SUPABASE_BOOKING_QUOTE_PDF_BUCKET=booking-quote-pdfs

# --- Story 18.9 / FE.18.8 — `/account/profile` avatar upload (Supabase Storage bucket `account_profile_avatars`) ---
# Server-only. Unset or 0/false = upload UI hidden (RLS-safe bucket may still exist). Truthy: 1 | true | yes | on (case-insensitive after trim).
# ACCOUNT_PROFILE_AVATAR_UPLOAD_ENABLED=0

# --- Dispatch guardrail admin override (Epic 13 / Q12) — server-only HMAC secret, min 32 chars ---
# DISPATCH_OVERRIDE_SECRET=generate-a-long-random-string-at-least-32-chars

# --- Quote deep-link HMAC (Epic 14 / Theme B) — server-only, never NEXT_PUBLIC_* or logs; UTF-8 >= 32 bytes after trim ---
# Required in production. Under `next dev`, if unset, a built-in dev-only key is used (see `registerQuoteLinkSigningKeyFromEnvInInstrumentation` in `src/lib/quote-tokens.ts`); set this in .env.local for parity with deployed envs.
# QUOTE_LINK_SIGNING_KEY=generate-a-long-random-string-at-least-32-chars

# --- Account portal member invite HMAC (Epic 15 / 15A.6) — server-only; UTF-8 >= 32 bytes after trim ---
# Preferred over reusing QUOTE_LINK_SIGNING_KEY. If unset, invite signing falls back to QUOTE_LINK_SIGNING_KEY when present.
# VESTROO_ACCOUNT_INVITE_SIGNING_KEY=generate-a-long-random-string-at-least-32-chars

# --- Story 14.7 (US-D3) — quote-first for non-trivial walk-in intents (server-only) ---
# When unset or empty, treated as ON (default after 14.7). OFF only if set to one of: 0 | false | no | off (case-insensitive after trim).
# Any other value (e.g. 1, true, yes, on) is ON. See `isQuoteFirstForNonTrivialIntentsEnabled` in `src/lib/quote-first-non-trivial-intents.ts`.
# QUOTE_FIRST_FOR_NON_TRIVIAL_INTENTS=1

# --- Trip-request funnel analytics (Epic 19 / FE.19.10) — client-safe NEXT_PUBLIC_* ---
# When unset, analytics forwarding is OFF (safe default). Enable with: 1 | true | yes | on (case-insensitive).
# NEXT_PUBLIC_BOOKING_FUNNEL_ANALYTICS_ENABLED=1
# Optional: log sanitized events to the console in development only.
# NEXT_PUBLIC_BOOKING_FUNNEL_ANALYTICS_DEBUG=1
# A/B variant label attached to every event (non-PII). Default in code: v_booking_slides_v2.
# NEXT_PUBLIC_BOOKING_FUNNEL_VARIANT=v_booking_slides_v2
# Product hook (optional): assign `window.__VESTROO_TRACK_BOOKING_FUNNEL__ = ({ name, properties }) => { ... }` to forward to your provider without adding an npm dependency.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional public status / incidents page URL for `/account/help` (Story 18.10 / FE.18.9). Omit or leave empty to hide the status card.
# NEXT_PUBLIC_STATUS_PAGE_URL=https://status.example.com

# --- POPIA / email footers (Epic 15 / **15C.6** — server-only; never put secrets in NEXT_PUBLIC_*) ---
# Legal / trading name and physical address appear in **HTML** **email** footers (matrix + account invite). Defaults exist in code for non-production.
# COMPANY_LEGAL_NAME=Vestroo (Pty) Ltd
# COMPANY_TRADING_NAME=Vestroo
# **Multi-line** OK in .env (quoted) for street / postal address.
# COMPANY_REGISTERED_ADDRESS=…
# **Optional** public **privacy** URL (walk-in / no portal footers; **https**). Not exposed to the browser bundle.
# PUBLIC_PRIVACY_URL=https://vestroo.com/privacy
# **Optional** path on `NEXT_PUBLIC_APP_URL` for “Contact” in walk-in email footers (default `/contact` if unset).
# PUBLIC_MARKETING_CONTACT_PATH=/contact
