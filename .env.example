# Google Maps API
# Google Maps API key for Places Autocomplete and Distance Matrix
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSyDidSsAKQXby9B26uY2S0J4nXJSBqicp3A

# PayFast Payment Gateway
# PayFast merchant ID (exposed to client)
NEXT_PUBLIC_PAYFAST_MERCHANT_ID=your-merchant-id
# PayFast merchant key (exposed to client)
NEXT_PUBLIC_PAYFAST_MERCHANT_KEY=your-merchant-key
# PayFast API endpoint URL
# Sandbox: https://sandbox.payfast.co.za
# Production: https://www.payfast.co.za
NEXT_PUBLIC_PAYFAST_URL=https://sandbox.payfast.co.za
# PayFast passphrase (server-side only)
PAYFAST_PASSPHRASE=your-passphrase

# Email Configuration (Resend)
# Resend API key for sending transactional emails
RESEND_API_KEY=your-resend-api-key
# Email address to send confirmation emails from
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Application Configuration
# Application base URL (used for PayFast return URLs)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
# Development: development
# Production: production
NODE_ENV=development
