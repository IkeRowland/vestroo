# Playwright / Epic 12 E2E (Story 12.9) — copy to `.env.test` locally or set in CI secrets.
# Never commit real passwords or production URLs.

# Required for `npm run dev` + Supabase-backed flows (usually already in `.env.local`).
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server actions (`createBooking`, trip-request insert) — required for full E2E

# Staff session for `/ops/**` Playwright tests (dispatcher or admin profile in `public.profiles`).
E2E_OPS_STAFF_EMAIL=
E2E_OPS_STAFF_PASSWORD=

# Optional admin profile for Epic 13 Story 13.12 dispatch-override audit assertions (`profiles.role = admin`).
# E2E_OPS_ADMIN_EMAIL=
# E2E_OPS_ADMIN_PASSWORD=

# Resend: use a test key so `sendEmail` skips outbound HTTP in non-production (`re_test_…`).
# RESEND_API_KEY=re_test_your_key

# Epic 13 Theme C retry spec: set when running **only** that spec so `webServer` enables simulated Resend failures
# (default Playwright run excludes `epic13-theme-c-resend-failure.spec.ts` — see `playwright.config.ts`).
# E2E_SIMULATE_RESEND_API_FAILURE=1

# Quote deep-links (`/q/...`) — must match Next.js dev server (≥32 UTF-8 bytes). Default in `playwright.config.ts` is
# only for local convenience; set explicitly in CI/staging.
# QUOTE_LINK_SIGNING_KEY=your-at-least-32-byte-secret-for-quote-tokens

# Epic 16 / Theme N (US-N2) — checkout provider removed; the previous third-party sandbox
# vars used by the walk-in accept → webhook ITN spec are no longer needed and that spec has
# been retired. Use `markBookingPaymentReceived` (US-N3) when running EFT-flow E2E specs.

# Optional: full Q6 domain-match E2E — seed `customer_accounts.authorized_email_domains` first,
# then set an email whose domain matches (see `BookingAccountDomainGate`).
# E2E_DOMAIN_PROBE_EMAIL=user@your-seeded-domain.example

# Epic 15 / 15A.10 — account portal Playwright (`tests/e2e/epic15-15a10-portal-golden-paths.spec.ts`)
# Supabase **customer** users (not ops staff). Never commit real passwords.
E2E_PORTAL_ADMIN_EMAIL=
E2E_PORTAL_ADMIN_PASSWORD=
E2E_PORTAL_BOOKER_EMAIL=
E2E_PORTAL_BOOKER_PASSWORD=
# Optional: rider-only assertion (must differ from booker email).
# E2E_PORTAL_RIDER_EMAIL=
# E2E_PORTAL_RIDER_PASSWORD=
# Cross-account negative: UUID of a booking row outside the booker’s active account.
# E2E_PORTAL_FOREIGN_BOOKING_ID=
# Dual-membership switcher test (same user, two accepted memberships). Off by default in CI.
# E2E_PORTAL_DUAL_ACCOUNT=1
# When invoices archive has no “View HTML” row, open this quote id directly (UUID).
# E2E_PORTAL_INVOICE_QUOTE_ID=

# Epic 15 / **15C.8** (Story 15.26) — comms matrix E2E (`tests/e2e/epic15-15c8-comms-matrix-e2e.spec.ts`)
# Reuses the same **non-secret** placeholders as above: **E2E_OPS_STAFF_***, **E2E_PORTAL_BOOKER_***, plus
# **NEXT_PUBLIC_SUPABASE_URL** + **NEXT_PUBLIC_SUPABASE_ANON_KEY** (not listed again here; see top of this file).
# No dedicated `E2E_15C8_*` secrets are required. Optional: document opt-in in Progress Notes if you add gates later.

# Epic 15 / **15B.8** — rider tracking Playwright (`tests/e2e/epic15-15b8-rider-tracking-privacy.spec.ts`)
# Valid **`/track/[token]`** path: same Supabase + signing key contract as quote E2E.
# E2E_RIDER_TRACK_TRIP_ID=00000000-0000-4000-8000-000000000000   # optional; defaults to newest `trips` row
# Live map (Q22) — **off** in default CI. Opt-in only when data + env support it:
# E2E_RIDER_LIVE_MAP=1
# RIDER_LIVE_LOCATION_ENABLED=1
# E2E_RIDER_LIVE_MAP_TRIP_ID=00000000-0000-4000-8000-000000000000   # trip with coords + account live_rider_tracking
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_browser_restricted_key
# Field / 15B.6 indicator — **optional**; skip if unset:
# E2E_FIELD_CHAUFFEUR_EMAIL=
# E2E_FIELD_CHAUFFEUR_PASSWORD=
# E2E_FIELD_LIVE_TRACK_TRIP_ID=00000000-0000-4000-8000-000000000000

# Epic 15 / **15D.5** (Story 15.31) — dispatch suggestions + calibration E2E
# (`tests/e2e/epic15-15d5-dispatch-suggestions-e2e.spec.ts`). Reuses **E2E_OPS_STAFF_***,
# **NEXT_PUBLIC_SUPABASE_***, **SUPABASE_SERVICE_ROLE_KEY** (see top of file).
# Must be truthy on the **Next** dev server: forwarded via `playwright.config.ts` `webServer.env`.
# DISPATCH_SUGGESTIONS_ENABLED=1
# Paid-queue booking UUIDs (`ready_to_assign`, no `booking_trips` row until the test assigns):
# E2E_15D5_SUGGESTION_BOOKING_ID=00000000-0000-4000-8000-000000000000
# E2E_15D5_FREE_PICK_BOOKING_ID=00000000-0000-4000-8000-000000000001
# Optional — AC7 all-busy / excluded panel + assign:
# E2E_15D5_ALL_BUSY_BOOKING_ID=00000000-0000-4000-8000-000000000002
# Optional — AC6 thin-data panel (defaults to suggestion id if unset):
# E2E_15D5_THIN_DATA_BOOKING_ID=00000000-0000-4000-8000-000000000003

# Epic 17 / **FE.17.3** — sidebar promo slot. Leave off in CI unless a test opts in.
# NEXT_PUBLIC_OPS_SIDEBAR_PROMO_ENABLED=0
